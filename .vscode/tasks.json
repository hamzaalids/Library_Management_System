{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Library",
            "type": "process",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-pedantic",
                "main.cpp",
                "Book.cpp",
                "Member.cpp",
                "Loan.cpp",
                "Library.cpp",
                "-o",
                "library.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build and Run Library",
            "type": "process",
            "command": "${workspaceFolder}\\library.exe",
            "dependsOn": "Build Library",
            "dependsOrder": "sequence",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}
